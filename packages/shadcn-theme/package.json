{
    "name": "@kc-studio/shadcn-theme",
    "version": "250004.0.23",
    "private": false,
    "description": "Starter for Keycloakify themes using React, Shadcn, TailwindCSS and Keycloakify",
    "keywords": [],
    "homepage": "https://github.com/Oussemasahbeni/keycloakify-shadcn-starter#readme",
    "bugs": {
        "url": "https://github.com/Oussemasahbeni/keycloakify-shadcn-starter/issues"
    },
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Oussemasahbeni/keycloakify-shadcn-starter.git"
    },
    "type": "module",
    "imports": {
        "#/*": "./src/*"
    },
    "exports": {
        "./preview": "./src/login/preview.tsx",
        "./theme": "./src/login/theme/index.ts",
        "./email": "./src/email/index.ts",
        "./email-preview": "./src/email/preview.tsx",
        "./account-preview": "./src/account/preview/index.ts"
    },
    "scripts": {
        "postinstall": "keycloakify sync-extensions",
        "sync-extensions": "keycloakify sync-extensions",
        "prepare:publish": "node scripts/prepare-publish.js",
        "dev": "vite",
        "build": "tsc && vite build",
        "build-storybook": "storybook build",
        "build-keycloak-theme": "pnpm run build && keycloakify build",
        "storybook": "storybook dev -p 6006",
        "fmt": "oxfmt",
        "fmt:check": "oxfmt --check",
        "lint": "oxlint --type-aware --type-check",
        "lint:fix": "oxlint --type-aware --type-check --fix",
        "emails:check": "email check ./src/email/templates",
        "emails:preview": "email preview ./src/email/templates"
    },
    "dependencies": {
        "@base-ui/react": "^1.8.0",
        "@fontsource-variable/figtree": "^5.2.10",
        "@fontsource-variable/geist": "^5.2.9",
        "@fontsource-variable/ibm-plex-sans": "^5.2.8",
        "@fontsource-variable/inter": "^5.2.8",
        "@fontsource-variable/jetbrains-mono": "^5.2.8",
        "@fontsource-variable/lora": "^5.2.8",
        "@fontsource-variable/manrope": "^5.2.8",
        "@fontsource-variable/playfair-display": "^5.2.8",
        "@fontsource-variable/source-sans-3": "^5.2.9",
        "@keycloak/keycloak-admin-client": "26.7.0",
        "@keycloakify/keycloak-account-ui": "~260700.0.3",
        "@keycloakify/keycloak-ui-shared": "~260700.0.2",
        "@keycloakify/login-ui": "~250004.8.0",
        "@patternfly/patternfly": "^5.4.2",
        "@patternfly/react-core": "^5.4.14",
        "@patternfly/react-icons": "^5.4.2",
        "@patternfly/react-styles": "^5.4.1",
        "@patternfly/react-table": "^5.4.16",
        "@tailwindcss/vite": "catalog:",
        "@tanstack/react-query": "catalog:tanstack",
        "class-variance-authority": "^0.7.1",
        "cn": "^0.2.5",
        "culori": "^4.0.2",
        "i18next": "^25.7.3",
        "i18next-fetch-backend": "^7.0.0",
        "input-otp": "^1.4.2",
        "keycloakify": "^11.16.0",
        "lodash-es": "^4.18.1",
        "lucide-react": "^1.16.0",
        "oidc-spa": "~10.2.10",
        "react": "catalog:",
        "react-dom": "catalog:",
        "react-hook-form": "^7.70.0",
        "react-i18next": "^16.5.1",
        "react-icons": "^5.6.0",
        "react-router-dom": "^6.30.4",
        "rfc4648": "^1.5.4",
        "tailwindcss": "catalog:",
        "tsafe": "^1.8.5",
        "tw-animate-css": "^1.4.0"
    },
    "devDependencies": {
        "@storybook/react-vite": "^10.4.0",
        "@types/culori": "^4.0.1",
        "@types/lodash-es": "^4.17.12",
        "@types/node": "^25.9.1",
        "@types/react": "^19.2.15",
        "@types/react-dom": "^19.2.3",
        "@vitejs/plugin-react": "^6.1.1",
        "eslint-plugin-storybook": "^10.4.0",
        "jsx-email": "^3.2.1",
        "keycloakify-emails": "3.4.0",
        "oxfmt": "catalog:",
        "oxlint": "catalog:",
        "oxlint-tsgolint": "catalog:",
        "shadcn": "^4.15.0",
        "storybook": "^10.4.0",
        "typescript": "catalog:",
        "vite": "catalog:"
    },
    "engines": {
        "node": "^18.0.0 || >=20.0.0"
    },
    "packageManager": "pnpm@11.0.0"
}
