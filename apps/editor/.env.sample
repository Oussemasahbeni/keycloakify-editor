
OIDC_ISSUER_URI=https://cloud-iam.keycloakify.dev/realms/keycloakify-shadcn-editor
OIDC_CLIENT_ID=shadcn-theme-editor
OIDC_ACCESS_TOKEN_EXPECTED_AUDIENCE=account
DATABASE_URL=

# Neon Object Storage (S3 API) for images uploaded to saved themes.
# `neon buckets create <name>` and
# `neon credentials create --scope storage:read --scope storage:write`
# Then allow the editor's sites to reach the bucket from the browser:
# `node --env-file=.env scripts/set-bucket-cors.mjs http://localhost:3000 https://<your-site>`
AWS_ENDPOINT_URL_S3=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
THEME_ASSETS_BUCKET=
